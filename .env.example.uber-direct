# ─────────────────────────────────────────────────────────────
# Uber Direct (migration 019 — plate delivery integration)
# ─────────────────────────────────────────────────────────────
# Add these to your .env.local AND to Netlify's env config
# (Site settings → Environment variables) before running any
# Uber-Direct-touching code path.
#
# Where to get them:
#   1. Sign up at https://direct.uber.com (business account)
#   2. Wait 1-3 business days for verification
#   3. Dashboard → App settings → Developer credentials
#      shows client_id, client_secret, customer_id
#   4. Dashboard → Webhooks shows the signing secret
#
# Without these set, the code throws an explicit error rather
# than silently 401-ing — every Uber-touching route checks for
# the env vars before making the API call.

# OAuth2 credentials (Uber Direct Direct API)
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=

# Customer-of-customers id — Uber assigns this when your
# business account is verified. NOT the same as your Uber
# account id; it's specific to the Direct merchant relationship.
UBER_DIRECT_CUSTOMER_ID=

# `sandbox` (test orders, no real couriers) or `prod`
# (real money, real deliveries). Default is sandbox to prevent
# accidental real deliveries during development.
UBER_DIRECT_ENV=sandbox

# Webhook signing secret for verifying inbound delivery
# status updates. HMAC-SHA256 over the raw request body.
# Confirm the exact signing scheme + header name from Uber's
# webhooks dashboard before flipping to prod.
UBER_DIRECT_WEBHOOK_SECRET=
